{{!
    @template mod_oralassessment/student

    Displays the learner oral assessment interface.

    Example context (json):
    {}
}}
<div class="mod-oralassessment" id="oralassessment-app">
    <div class="mb-3">{{{intro}}}</div>
    <div class="alert alert-info">{{privacywarning}}</div>
    <div class="alert alert-secondary">{{recordingnotice}}</div>
    <div class="small text-muted mb-3">{{#str}}browserprivacy, mod_oralassessment{{/str}}</div>
    {{#storeaudio}}
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="oralassessment-audio-consent">
            <label class="form-check-label" for="oralassessment-audio-consent">
                {{#str}}recordingconsent, mod_oralassessment{{/str}}
            </label>
        </div>
    {{/storeaudio}}

    {{#canreview}}
        <p><a class="btn btn-outline-secondary" href="{{{reviewurl}}}">{{#str}}reviewattempts, mod_oralassessment{{/str}}</a></p>
    {{/canreview}}

    {{#finished}}
        {{> mod_oralassessment/result}}
    {{/finished}}

    {{^finished}}
        <div id="oralassessment-error" class="alert alert-danger d-none" role="alert"></div>
        <button type="button" id="oralassessment-start" class="btn btn-primary {{#hascurrentquestion}}d-none{{/hascurrentquestion}}">
            {{#str}}startassessment, mod_oralassessment{{/str}}
        </button>

        <div id="oralassessment-session" class="{{^hascurrentquestion}}d-none{{/hascurrentquestion}}">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h3 class="h5">{{#str}}currentquestion, mod_oralassessment{{/str}}</h3>
                    <p id="oralassessment-question" class="lead mb-0">{{currentquestion}}</p>
                </div>
                <div class="text-nowrap">
                    <strong>{{#str}}timeleft, mod_oralassessment{{/str}}:</strong>
                    <span id="oralassessment-timer">--:--</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="oralassessment-transcript">{{#str}}transcript, mod_oralassessment{{/str}}</label>
                <textarea class="form-control" id="oralassessment-transcript" rows="7" maxlength="20000"></textarea>
            </div>

            <div class="d-flex flex-wrap gap-2">
                {{#showrecordbutton}}
                    <button type="button" id="oralassessment-record" class="btn btn-outline-primary">
                        {{#str}}record, mod_oralassessment{{/str}}
                    </button>
                    <button type="button" id="oralassessment-stop" class="btn btn-outline-danger d-none">
                        {{#str}}stoprecording, mod_oralassessment{{/str}}
                    </button>
                {{/showrecordbutton}}
                <button type="button" id="oralassessment-submit" class="btn btn-primary">
                    {{#str}}submitresponse, mod_oralassessment{{/str}}
                </button>
            </div>
        </div>
    {{/finished}}
</div>
