{{!
    @template mod_oralassessment/result

    Displays the completed oral assessment result.

    Example context (json):
    {}
}}
<div class="mod-oralassessment-result">
    <div class="alert alert-success">{{#str}}assessmentfinished, mod_oralassessment{{/str}}</div>
    <div class="alert alert-warning">{{#str}}aigeneratednotice, mod_oralassessment{{/str}}</div>
    {{#awaitingreview}}<div class="alert alert-info">{{#str}}awaitingreview, mod_oralassessment{{/str}}</div>{{/awaitingreview}}
    {{#reviewoptional}}<div class="alert alert-info">{{#str}}reviewoptional, mod_oralassessment{{/str}}</div>{{/reviewoptional}}

    {{#attempt.hasaierror}}
        <div class="alert alert-warning">{{attempt.aierror}}</div>
    {{/attempt.hasaierror}}

    <h3 class="h5">{{#str}}questionsandresponses, mod_oralassessment{{/str}}</h3>
    <div class="oralassessment-transcript mb-4">
        {{#attempt.turns}}
            {{#isquestion}}
                <div class="oralassessment-turn oralassessment-question mb-2"><strong>Q{{turnnumber}}.</strong> {{text}}</div>
            {{/isquestion}}
            {{#isresponse}}
                <div class="oralassessment-turn oralassessment-response mb-3">
                    <strong>A{{turnnumber}}.</strong> {{text}}
                    {{#audio}}
                        <div class="mt-2"><audio controls preload="none" src="{{{audio}}}"></audio></div>
                    {{/audio}}
                </div>
            {{/isresponse}}
        {{/attempt.turns}}
    </div>

    {{#attempt.hassummary}}
        <h3 class="h5">{{#str}}summary, mod_oralassessment{{/str}}</h3>
        <p>{{attempt.summary}}</p>
    {{/attempt.hassummary}}

    {{#attempt.hasevidence}}
        <h3 class="h5">{{#str}}evidence, mod_oralassessment{{/str}}</h3>
        <ul>
            {{#attempt.evidence}}
                <li><strong>{{criterion}}</strong>: {{evidence}}</li>
            {{/attempt.evidence}}
        </ul>
    {{/attempt.hasevidence}}

    {{#attempt.hasreviewpoints}}
        <h3 class="h5">{{#str}}reviewpoints, mod_oralassessment{{/str}}</h3>
        <ul>
            {{#attempt.reviewpoints}}<li>{{text}}</li>{{/attempt.reviewpoints}}
        </ul>
    {{/attempt.hasreviewpoints}}

    {{#attempt.hasgrade}}<p><strong>{{#str}}grade, mod_oralassessment{{/str}}:</strong> {{attempt.grade}}</p>{{/attempt.hasgrade}}
    {{#attempt.hasfeedback}}<div><strong>{{#str}}feedback, mod_oralassessment{{/str}}:</strong> {{{attempt.feedback}}}</div>{{/attempt.hasfeedback}}
</div>
